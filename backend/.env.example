# Required: PostgreSQL connection URL (a Supabase PostgreSQL URL is supported).
# This is not an API key. URL-encode reserved characters in the password.
DATABASE_URL=

# External API keys -----------------------------------------------------------

# Optional/legacy: Google Routes adapter tests remain, but the normal optimizer uses local estimates.
GOOGLE_ROUTES_API_KEY=

# Optional: Geoapify, used for destination and arrival autocomplete/geocoding.
# Leave empty to disable Geoapify cleanly; the endpoint will return HTTP 503.
GEOAPIFY_API_KEY=

# Geoapify client settings ----------------------------------------------------
GEOAPIFY_BASE_URL=https://api.geoapify.com
GEOAPIFY_TIMEOUT_SECONDS=8
GEOAPIFY_AUTOCOMPLETE_CACHE_TTL_SECONDS=300

# OpenStreetMap POI discovery -------------------------------------------------
# Optional free public or self-hosted Overpass endpoint. Public instances are
# best-effort, so production scale should evaluate extracts or self-hosting.
OVERPASS_API_URL=https://lz4.overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=25
OVERPASS_RADIUS_METERS=8000
OVERPASS_TOURISM_RADIUS_METERS=15000
OVERPASS_HERITAGE_RADIUS_METERS=15000
OVERPASS_RELIGIOUS_RADIUS_METERS=10000
OVERPASS_FOOD_RADIUS_METERS=8000
OVERPASS_CAFE_RADIUS_METERS=8000
OVERPASS_MARKETS_RADIUS_METERS=10000
OVERPASS_NATURE_RADIUS_METERS=25000
OVERPASS_TOURISM_LIMIT=60
OVERPASS_HERITAGE_LIMIT=60
OVERPASS_RELIGIOUS_LIMIT=40
OVERPASS_FOOD_LIMIT=50
OVERPASS_CAFE_LIMIT=40
OVERPASS_MARKETS_LIMIT=40
OVERPASS_NATURE_LIMIT=40

# FSQ Open Source Places import -----------------------------------------------
# No Foursquare runtime API key is required. Download/export FSQ OS Places
# separately through the Foursquare Places Portal, then point this at the local
# filtered CSV/JSONL/NDJSON file. --source on the CLI overrides this value.
FSQ_OS_PLACES_PATH=
AUDIALA_DATASET_PATH=backend/app/data/audiala_places.json
FSQ_DEDUPE_DISTANCE_METERS=75
FSQ_IMPORT_BATCH_SIZE=250

# Cache settings --------------------------------------------------------------
ROUTE_MATRIX_TRAFFIC_TTL_MINUTES=30
PLACE_DISCOVERY_CACHE_TTL_HOURS=24

# Road route geometry settings ------------------------------------------------
# Routing provider: "osrm" (default keyless OSM routing) or "openrouteservice"
ROUTING_PROVIDER=osrm
# Optional: openrouteservice hosted API key (free token from openrouteservice.org)
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org
OPENROUTESERVICE_TIMEOUT_SECONDS=10
# OSRM router endpoint for keyless open-data road geometry
OSRM_ROUTER_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=10
ROUTE_GEOMETRY_CACHE_TTL_MINUTES=60

# Weather advisory settings ---------------------------------------------------
# Weather provider: "openmeteo" (default)
WEATHER_PROVIDER=openmeteo
# Open-Meteo API base URL (hosted free endpoint has non-commercial restrictions)
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_TIMEOUT_SECONDS=10
WEATHER_CACHE_TTL_MINUTES=60
