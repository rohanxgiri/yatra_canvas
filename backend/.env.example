# Required: backend database (PostgreSQL; a Supabase connection URL is supported)
DATABASE_URL=

# Optional: Google Places API (New), used for city search and nearby POI discovery
GOOGLE_PLACES_API_KEY=

# Optional: Google Routes API, used for route-matrix optimization
GOOGLE_ROUTES_API_KEY=

# Optional: Geoapify, used for location autocomplete/geocoding
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com
GEOAPIFY_TIMEOUT_SECONDS=8
GEOAPIFY_AUTOCOMPLETE_CACHE_TTL_SECONDS=300

# Optional: local Foursquare Open Source Places import (no runtime API token)
FSQ_OS_PLACES_PATH=
FSQ_DEDUPE_DISTANCE_METERS=75
FSQ_IMPORT_BATCH_SIZE=250

# Optional: cache and POI-discovery tuning
ROUTE_MATRIX_TRAFFIC_TTL_MINUTES=30
PLACE_DISCOVERY_CACHE_TTL_HOURS=24
GOOGLE_NEARBY_RADIUS_METERS=10000
PLACE_POPULAR_MIN_RATING=4.2
PLACE_POPULAR_MIN_REVIEW_COUNT=100
