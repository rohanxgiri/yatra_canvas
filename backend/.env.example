# Required: PostgreSQL connection URL from Supabase (Project Settings > Database).
# This is not an API key. URL-encode reserved characters in the password.
DATABASE_URL=postgresql://YOUR_DATABASE_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_DATABASE_HOST:5432/postgres

# External API keys -----------------------------------------------------------

# Google Cloud key with Places API (New) enabled.
# Used for destination-city discovery and the existing nearby-place pipeline.
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY

# Google Cloud key with Routes API enabled.
# Used for route matrices and itinerary route optimization.
# This may be the same Google key as above if both APIs are enabled, although
# separate restricted keys are recommended for least-privilege deployments.
GOOGLE_ROUTES_API_KEY=YOUR_GOOGLE_ROUTES_API_KEY

# Geoapify project key from https://myprojects.geoapify.com/.
# Used only for user-facing hotel/custom start-location autocomplete.
# Leave empty to disable Geoapify cleanly; the endpoint will return HTTP 503.
GEOAPIFY_API_KEY=YOUR_GEOAPIFY_API_KEY

# Geoapify client settings ----------------------------------------------------
GEOAPIFY_BASE_URL=https://api.geoapify.com
GEOAPIFY_TIMEOUT_SECONDS=8
GEOAPIFY_AUTOCOMPLETE_CACHE_TTL_SECONDS=300

# FSQ Open Source Places import -----------------------------------------------
# No Foursquare runtime API key is required. Download/export FSQ OS Places
# separately through the Foursquare Places Portal, then point this at the local
# filtered CSV/JSONL/NDJSON file. --source on the CLI overrides this value.
FSQ_OS_PLACES_PATH=
FSQ_DEDUPE_DISTANCE_METERS=75
FSQ_IMPORT_BATCH_SIZE=250

# Existing discovery, routing, and ranking settings --------------------------
ROUTE_MATRIX_TRAFFIC_TTL_MINUTES=30
PLACE_DISCOVERY_CACHE_TTL_HOURS=24
GOOGLE_NEARBY_RADIUS_METERS=10000
PLACE_POPULAR_MIN_RATING=4.2
PLACE_POPULAR_MIN_REVIEW_COUNT=100
